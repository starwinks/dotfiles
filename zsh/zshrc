# =============================================================================
# ~/.zshrc - Oh My Zsh configuration with modular design
# Source: ~/.dotfiles/zsh/zshrc
# Managed via dotfiles git repo with symbolic links
# =============================================================================

# Enable Powerlevel10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to Oh My Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins
plugins=(
    git
    z
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# =============================================================================
# Module loading (similar to bash modular design)
# =============================================================================
ZSH_MODULES_DIR="${${(%):-%x}:A:h}/modules"

# Load shared modules first. secrets.zsh is intentionally optional because it
# is a per-machine, gitignored file.
for module in exports.zsh secrets.zsh func.zsh alias.zsh; do
  module_file="$ZSH_MODULES_DIR/$module"
  [[ -r "$module_file" ]] && source "$module_file"
done

# Load machine-specific modules when they exist. These files are kept separate
# so the shared modules remain portable across machines.
for module in exports.local.zsh func.local.zsh alias.local.zsh; do
  module_file="$ZSH_MODULES_DIR/$module"
  [[ -r "$module_file" ]] && source "$module_file"
done

# =============================================================================
# P10k configuration
# =============================================================================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
