# =============================================================================
# ~/.zshrc - Modern native Zsh configuration with Starship prompt
# Source: ~/.dotfiles/zsh/zshrc
# Managed via dotfiles git repo with symbolic links
# =============================================================================

# Load machine-local paths before startup code.
DOTFILES_PATHS_FILE="${DOTFILES_PATHS_FILE:-$HOME/.config/dotfiles/paths.env}"
[[ -r "$DOTFILES_PATHS_FILE" ]] && source "$DOTFILES_PATHS_FILE"

: "${DOTFILES_HOME:=$HOME}"
: "${DOTFILES_DATA:=$DOTFILES_HOME}"
export DOTFILES_HOME DOTFILES_DATA

# Prevent Conda from polluting prompt with raw text
export CONDA_CHANGEPS1=no

# =============================================================================
# Module loading
# =============================================================================
ZSH_MODULES_DIR="${${(%):-%x}:A:h}/modules"

# Core shell modules:
# exports -> secrets -> history -> completion -> keybindings -> func -> alias -> plugins
for module in exports.zsh secrets.zsh history.zsh completion.zsh keybindings.zsh func.zsh alias.zsh plugins.zsh; do
  module_file="$ZSH_MODULES_DIR/$module"
  [[ -r "$module_file" ]] && source "$module_file"
done

# Machine-specific modules (gitignored)
for module in exports.local.zsh func.local.zsh alias.local.zsh; do
  module_file="$ZSH_MODULES_DIR/$module"
  [[ -r "$module_file" ]] && source "$module_file"
done

# =============================================================================
# Starship prompt initialization
# =============================================================================
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

# Machine-specific environment script
[[ -r "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
